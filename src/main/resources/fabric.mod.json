{
  "schemaVersion": 1,
  "id": "neonclient",
  "version": "${version}",
  "name": "Neon Client",
  "description": "Client-side GUI with toggleable modules. Press Right Shift to open.",
  "authors": ["You"],
  "environment": "client",
  "entrypoints": {
